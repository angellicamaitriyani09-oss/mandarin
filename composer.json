{
    "name": "mandarinku/web",
    "type": "project",
    "description": "Mandarinku - Platform Pembelajaran Bahasa Mandarin Interaktif HSK 1-6 berbasis Laravel MVC",
    "keywords": ["laravel", "mandarin", "hsk", "edtech", "mandarinku"],
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
